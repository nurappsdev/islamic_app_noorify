<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml, for both cloud backup and
     device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dev.fluttercommunity.plus.android_alarm_manager_plugin.xml"/>
        <exclude domain="root" path="app_flutter/alarms_box.hive"/>
        <exclude domain="root" path="app_flutter/alarms_box.lock"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dev.fluttercommunity.plus.android_alarm_manager_plugin.xml"/>
        <exclude domain="root" path="app_flutter/alarms_box.hive"/>
        <exclude domain="root" path="app_flutter/alarms_box.lock"/>
    </device-transfer>
</data-extraction-rules>
