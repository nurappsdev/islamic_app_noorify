<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_rounded_mask"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:src="@drawable/prayer_theme_1" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_full_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/small_badge_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:maxLines="1"
            android:gravity="center"
            tools:text="যোহর নামাজ" />

        <TextView
            android:id="@+id/small_badge_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:maxLines="1"
            android:gravity="center"
            tools:text="১২:০৪ – ৪:২২" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/prayer_sejda_icon" />

            <TextView
                android:id="@+id/small_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textSize="8sp"
                android:textStyle="italic"
                android:textColor="#6F7F52"
                android:singleLine="true"
                tools:text="আজকের আমল ট্র্যাক করুন" />
        </LinearLayout>
    </LinearLayout>

    <!-- A plain View isn't in RemoteViews' supported view allowlist and
         fails to inflate on the widget host ("Can't load widget"); an
         ImageView with no src is. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_border_overlay" />
</FrameLayout>
